# Transfera v2 — Environment template (TRACKED, no secrets)
# Copy to `.env` (gitignored) only if you need non-default local values.
# The backend has NO dotenv loader — these are read via plain
# `os.environ` / `process.env`. Most dev runs need none of these.

# Override the runtime data dir (default: backend/data/).
# Mirrors backend/config.py TRANSFERA_DATA_DIR + frontend/electron/main.ts.
# TRANSFERA_DATA_DIR=

# Backend log level (default: INFO).
# TRANSFERA_LOG_LEVEL=INFO

# Set to 1 when Electron should NOT spawn its own backend
# (run.py --frontend / npm run electron:dev sets this automatically).
# TRANSFERA_EXTERNAL_BACKEND=

# Release signing (local-only, NEVER commit the .pfx — *.pfx is gitignored).
# Generate via: frontend/scripts/generate-release-cert.ps1 (Admin pwsh),
# then build with: npm run electron:build
# CSC_LINK=frontend/release-certs/transfera-release.pfx
# CSC_KEY_PASSWORD=transfera-release-pwd

# Agent MCP helpers (local-only, NEVER commit real keys).
# Context7 raises rate limits when set; GitHub MCP prefers OAuth
# (`opencode mcp auth github`) over a pasted token.
# CONTEXT7_API_KEY=
# GITHUB_TOKEN=
