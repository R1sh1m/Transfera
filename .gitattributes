# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.exe binary
*.obj binary
*.pfx binary
*.zip binary
