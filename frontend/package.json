{
  "name": "transfera-frontend",
  "version": "2.8.3",
  "private": true,
  "type": "module",
  "description": "Transfera v2 - Local media backup desktop app",
  "author": "Transfera Team",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R1sh1m/Transfera.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:native": "node -e \"if(process.platform==='win32'){const {execSync}=require('child_process');execSync('cmd /c \\\"..\\\\native\\\\wpd_helper\\\\build.bat\\\"',{stdio:'inherit'})}else{console.log('build:native: WPD helper is Windows-only — skipping on '+process.platform)}\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-preflight.mjs && npm run build:native && tauri build",
    "tauri:check": "tauri info",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "overrides": {
    "jiti": "2.7.0"
  }
}
