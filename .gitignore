# Transfera v2 — Git Ignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
*.egg
.eggs/

# --- Runtime data ---
backend/data/
local_secret.json
*.db
*.db-wal
*.db-shm

# --- Node.js ---
node_modules/
frontend/dist/
frontend/vite.config.d.ts
frontend/vite.config.js
frontend/python-bin/
frontend/python-embed.zip
*.pfx
*.key
*.key.pub
*.tsbuildinfo


# --- Environment ---
.env
.env.local
.env.*.local
*.env
venv/
.venv/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS ---
desktop.ini
._*

# --- Logs ---
*.log
backend/data/logs/
backend.err

# --- Cache ---
.cache/
frontend/.cache/
backend/data/cache/

# --- Partial / temp files ---
*.partial
*.tmp

# --- Tauri shell (Rust + sidecar staging) ---
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/src-tauri/binaries/*
!frontend/src-tauri/binaries/.gitkeep
frontend/src-tauri/resources/*
!frontend/src-tauri/resources/.gitkeep
# Ignore the ExifTool runtime *contents* (33 MB Perl tree, staged at build
# time) but keep the directory itself tracked via .gitkeep: a missing dir
# makes the Tauri build-script fail with
# "glob pattern resources/exiftool_files path not found". Negations must
# re-include each level: resources/* hides the dir itself, so un-hide it
# first or git never descends far enough to see the .gitkeep exception.
!frontend/src-tauri/resources/exiftool_files/
frontend/src-tauri/resources/exiftool_files/*
!frontend/src-tauri/resources/exiftool_files/.gitkeep
# Ignore the frozen sidecar one-dir *contents* (~200 MB, staged at build
# time by scripts/build-sidecar.*) but keep the directory itself tracked via
# .gitkeep so the Tauri resources glob resolves on fresh checkouts (the
# preflight gate fails fast there instead of 9 min into the Rust build).
!frontend/src-tauri/resources/transfera-engine/
frontend/src-tauri/resources/transfera-engine/*
!frontend/src-tauri/resources/transfera-engine/.gitkeep
# VC++ redistributable (~25 MB, fetched at build time by
# scripts/build-sidecar.ps1 for the NSIS post-install hook). Never commit
# the binary; Unix builds carry a 0-byte placeholder instead.
frontend/src-tauri/resources/VC_redist*.exe
# PyInstaller one-dir output (mirrored into src-tauri/resources/transfera-engine/ by scripts/build-sidecar.ps1)
dist/transfera-engine/

# --- Packaged installer output (Tauri NSIS bundle + checksums) ---
frontend/release/
*.blockmap
SHA256SUMS.txt

# --- Test databases (created during test runs) ---
backend/data/db/test_*.db*

# --- ExifTool downloaded binaries ---
backend/bin/exiftool/

# --- Native build artifacts ---
backend/bin/wpd_helper.exe
backend/bin/wpd_helper_test.exe
backend/bin/wpd_helper/
backend/bin_debug/
native/wpd_helper/build/
build/
native/wpd_helper/.cache/
*.obj
*.pdb
*.ilk
*.exp

# --- Misc ---
*.bak
*.backup
coverage/
htmlcov/
.coverage
coverage.xml
digest.txt
skills-lock.json
Transfera_Architecture_Spec_v2.pdf

# --- Local agent notes (not committed) ---
.agents/AGENTS.md
.agents/verification-log.md
.agents/.cache/

# Scratch test data (not the test suite — that's in backend/tests/ and IS tracked)
test_dest/
test_source/
opencode.json
.pytest_cache/
.ruff_cache/
.mypy_cache/
test/
